{
  "name": "route-map",
  "version": "1.0.0",
  "description": "A GPX route drawn over map tiles as SVG, with a cursor shared with its elevation profile",
  "keywords": [
    "gpx",
    "route",
    "map",
    "elevation-profile",
    "svg",
    "astro",
    "cycling",
    "hiking"
  ],
  "license": "MIT",
  "author": "Daniel Hebberd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokyoDanInJapan/route-map.git"
  },
  "homepage": "https://github.com/TokyoDanInJapan/route-map#readme",
  "bugs": {
    "url": "https://github.com/TokyoDanInJapan/route-map/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "happy-dom": "^20.11.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
